<?xml version="1.0" encoding="utf-8"?>
<!-- 未选中：空心灰圆环（内白底，让环看起来是描边） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/radioOff" />
        </shape>
    </item>
    <item
        android:left="2dp"
        android:top="2dp"
        android:right="2dp"
        android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/radioOffInner" />
        </shape>
    </item>
</layer-list>
