<?xml version="1.0" encoding="utf-8"?>
<!--
  方案 14「进度聚焦」· 进度条轨道
  结构：外层 FrameLayout 用本 drawable 作背景（8dp 高、5dp 圆角、progressTrack 色），
  内层 View 用 bg_progress_fill 作背景，宽度由 HomeFragment 按百分比设置。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/progressTrack" />
    <corners android:radius="5dp" />
</shape>
