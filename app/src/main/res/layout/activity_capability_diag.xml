<?xml version="1.0" encoding="utf-8"?>
<!--
  能力自检详情页
  ==================================================================
  为什么单开一页（而不是塞进「模块诊断」弹窗）：诊断弹窗只是把文本怼出来，
  14 项能力平铺成一坨纯文字，用户根本分不清哪行是「哪项能力」；而且弹窗
  不能滚动到指定项、也没法逐项给「排查提示」。
  这里改成逐项卡片式列表：一行一项，左边状态徽标（勾/叉），中间能力名 +
  命中方法名/重载数，右边展开箭头；未命中项在下方给一行红色的排查提示。
  ==================================================================
  数据来源：SurvivalData.hookCaps()（hook 侧上报落盘），逐项渲染。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBg"
    android:scrollbars="none">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <!-- 顶部：返回 + 标题 + 重新检测 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="14dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:padding="7dp"
                android:src="@drawable/ic_chevron"
                android:rotation="90"
                android:background="@drawable/bg_round_button"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="返回" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="能力自检"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:id="@+id/btn_recheck"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="重新检测"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:background="@drawable/bg_chip"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- 概览卡：N/M 项生效 + 一句话说明（★ 059 P2：去掉无引用的 @+id/card_summary） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="15dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_card">

            <TextView
                android:id="@+id/summary_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:id="@+id/summary_desc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:lineSpacingExtra="3dp"
                android:textSize="12.5sp"
                android:textColor="@color/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- 列表标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="10dp"
            android:text="逐项明细"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:textColor="@color/colorOnSurfaceVariant" />

        <!-- 逐项列表（代码动态填充） -->
        <LinearLayout
            android:id="@+id/cap_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- 空态（无数据时显示） -->
        <TextView
            android:id="@+id/empty_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="暂无自检数据\n请确认已激活模块并重启手机，等待系统框架上报（通常开机后数十秒内完成）"
            android:textSize="13sp"
            android:textColor="@color/colorOnSurfaceVariant" />

        <!-- 页脚说明 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:lineSpacingExtra="3dp"
            android:text="说明：本模块依赖按名挂载系统私有方法实现保活，系统版本升级或厂商改版都可能导致个别方法改名，从而让对应能力静默失效。此处如实列出每项能力的挂载结局，未生效项不影响其余功能。"
            android:textSize="12sp"
            android:textColor="@color/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
