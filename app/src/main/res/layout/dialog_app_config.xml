<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="保活档位"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1b1b1f" />

    <RadioGroup
        android:id="@+id/rg_adj"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rb_fg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="前台级" />

        <RadioButton
            android:id="@+id/rb_vis"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="可见级" />

        <RadioButton
            android:id="@+id/rb_per"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="可感知级" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="拦截功能"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1b1b1f" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="阻止强制停止"
            android:textSize="15sp"
            android:textColor="#1b1b1f" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_force"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="阻止后台杀死"
            android:textSize="15sp"
            android:textColor="#1b1b1f" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_killbg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="强力模式"
            android:textSize="15sp"
            android:textColor="#1b1b1f" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_kill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="常驻进程"
            android:textSize="15sp"
            android:textColor="#1b1b1f" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_persist"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="消息保活（后台收消息）"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#1b1b1f" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保活消息进程"
            android:textSize="15sp"
            android:textColor="#1b1b1f" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/sw_msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="开启后豁免省电(Doze)与待机限制，后台网络/闹钟不被延迟；主进程将伪装为前台状态（部分应用检测到自己在后台会自行断开推送，伪装可避免）。注意：消息能否送达最终取决于应用与服务端，保活只负责让进程与网络可用。"
        android:textSize="12sp"
        android:textColor="#5a5a5a" />

</LinearLayout>
