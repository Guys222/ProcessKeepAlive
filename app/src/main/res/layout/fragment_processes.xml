<?xml version="1.0" encoding="utf-8"?>
<!--
  进程页（方案 14「进度聚焦」视觉）
  结构：标题 → 搜索条 → 筛选 chip 行（全部/仅应用 + 内存排序）→ 摘要行 → 列表（整卡包裹）
  复用应用页的搜索条与 chip 样式，保证整体一致。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:paddingStart="18dp"
        android:paddingEnd="12dp"
        android:paddingTop="12dp"
        android:paddingBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="进程"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/colorOnSurface" />

        <ImageButton
            android:id="@+id/btn_more"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="更多"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/colorOnSurface" />
    </LinearLayout>

    <!-- 搜索条（与应用页一致） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="13dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="11dp"
        android:paddingBottom="11dp"
        android:background="@drawable/bg_search">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_search"
            app:tint="@color/colorOnSurfaceVariant"
            android:contentDescription="搜索" />

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="9dp"
            android:hint="搜索应用或进程名…"
            android:textSize="14sp"
            android:textColor="@color/colorOnSurface"
            android:textColorHint="@color/colorOnSurfaceVariant"
            android:background="@null"
            android:inputType="text"
            android:maxLines="1" />
    </LinearLayout>

    <!-- 筛选 chip 行 -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:layout_marginBottom="10dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chip_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="全部进程"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface"
                android:background="@drawable/bg_chip_filter_active"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_app"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="仅应用"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceVariant"
                android:background="@drawable/bg_chip"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chip_sort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="内存↓"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurfaceVariant"
                android:background="@drawable/bg_chip"
                android:paddingStart="13dp"
                android:paddingEnd="13dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/proc_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="10dp"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.03"
        android:textColor="@color/colorOnSurfaceVariant" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <!-- 空列表占位：区分「从未收到上报」/「等待扫描」/「无匹配」三种情况 -->
        <LinearLayout
            android:id="@+id/empty_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="暂无进程"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorOnSurface" />

            <TextView
                android:id="@+id/empty_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:lineSpacingExtra="3dp"
                android:textSize="13sp"
                android:textColor="@color/colorOnSurfaceVariant" />
        </LinearLayout>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
