<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorOnPrimary">#ffffff</item>
        <item name="colorPrimaryContainer">@color/colorSurfaceVariant</item>
        <item name="colorOnPrimaryContainer">@color/colorOnSurface</item>
        <item name="colorSecondary">@color/colorPrimary2</item>
        <item name="colorSurface">@color/colorSurface</item>
        <item name="colorOnSurface">@color/colorOnSurface</item>
        <item name="colorOnSurfaceVariant">@color/colorOnSurfaceVariant</item>
        <item name="colorOutline">@color/colorOutline</item>
        <item name="android:statusBarColor">@color/colorBg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/colorBg</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNav</item>
    </style>

    <style name="Widget.App.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/colorSurface</item>
        <item name="itemIconTint">@color/colorOnSurfaceVariant</item>
        <item name="itemTextColor">@color/colorOnSurfaceVariant</item>
        <item name="itemActiveIndicatorStyle">@style/Widget.App.BottomNav.Active</item>
    </style>

    <style name="Widget.App.BottomNav.Active" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/colorSurfaceVariant</item>
    </style>
</resources>
